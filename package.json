{
  "name": "sony-alpha7iv-learning-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "seed": "node --experimental-strip-types src/data/seed.ts",
    "dev": "node --experimental-strip-types src/data/seed.ts && node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc --noEmit && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js src --max-warnings 0",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}
